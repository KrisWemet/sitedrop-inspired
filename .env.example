# Copy this file to `.env` (which is gitignored) and fill in the keys you have.
# Every feature degrades gracefully when its key is absent — nothing here is
# required to run the app. server.js loads this at startup; real environment
# variables always take precedence over the file.

# Licensed stock photos (bigger/better than the keyless Openverse CC0 default).
# Free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Claude copywriting for enrichment + AI pitch drafts. https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# One-click Vercel publishing. https://vercel.com/account/tokens
VERCEL_TOKEN=
# VERCEL_TEAM_ID=

# The business's real storefront photo from Google (PREVIEW ONLY, never shipped live).
GOOGLE_PLACES_API_KEY=

# Daily operator digest email (Resend). https://resend.com
RESEND_API_KEY=
OUTREACH_FROM=
DIGEST_TO=
# DIGEST_HOUR=8

# Hosted dashboard URL used in drafted pitch links.
# BASE_URL=https://your-host
